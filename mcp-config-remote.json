{
  "mcpServers": {
    "pansou-remote": {
      "command": "node",
      "args": [
        "C:\\full\\path\\to\\your\\project\\typescript\\dist\\index.js"
      ],
      "env": {
        "PANSOU_SERVER_URL": "https://so.252035.xyz",
        "REQUEST_TIMEOUT": "60",
        "MAX_RESULTS": "100",
        "DEFAULT_CLOUD_TYPES": "baidu,aliyun,quark,tianyi,uc,mobile,115,pikpak,xunlei,123,magnet,ed2k,others",
        "AUTO_START_BACKEND": "false",
        "DOCKER_MODE": "false",
        "BACKEND_SHUTDOWN_DELAY": "0",
        "BACKEND_STARTUP_TIMEOUT": "5000",
        "IDLE_TIMEOUT": "600000",
        "ENABLE_IDLE_SHUTDOWN": "false",
        "PROJECT_ROOT_PATH": "",
        "ENABLED_PLUGINS": "",
        "AUTH_ENABLED": "true",
        "AUTH_USERNAME": "admin",
        "AUTH_PASSWORD": "your_password_here"
      }
    }
  },
  "_comments": {
    "description": "PanSou MCP服务 - 连接官方远程服务配置",
    "version": "2.0",
    "远程服务说明": {
      "服务地址": "https://so.252035.xyz",
      "认证方式": "需要用户名和密码",
      "使用说明": [
        "1. 将 C:\\full\\path\\to\\your\\project 替换为你的项目实际路径",
        "2. 将 your_password_here 替换为你的实际密码",
        "3. 确保已构建 TypeScript MCP 服务: cd typescript && npm run build",
        "4. 在 Cherry Studio 中导入此配置文件"
      ]
    },
    "配置说明": {
      "PANSOU_SERVER_URL": "官方服务地址 https://so.252035.xyz",
      "REQUEST_TIMEOUT": "请求超时时间（秒），远程服务建议60秒",
      "MAX_RESULTS": "最大搜索结果数，远程服务建议100",
      "AUTO_START_BACKEND": "false - 不启动本地后端服务",
      "DOCKER_MODE": "false - 不使用Docker模式",
      "ENABLE_IDLE_SHUTDOWN": "false - 远程服务不需要空闲关闭",
      "AUTH_ENABLED": "true - 官方服务需要认证",
      "AUTH_USERNAME": "登录用户名",
      "AUTH_PASSWORD": "登录密码"
    },
    "注意事项": [
      "官方服务需要认证，请确保用户名密码正确",
      "远程服务可能有访问限制，请合理使用",
      "网络延迟可能影响响应速度，建议增加超时时间"
    ]
  }
}